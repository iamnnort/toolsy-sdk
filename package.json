{
  "name": "@iamnnort/toolsy-sdk",
  "version": "1.0.0",
  "description": "Toolsy SDK for Node.js, NestJS and browsers - Fast - Interactive - Simple",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/iamnnort/toolsy-sdk.git"
  },
  "bugs": "https://github.com/iamnnort/toolsy-sdk/issues",
  "homepage": "https://github.com/iamnnort/toolsy-sdk#readme",
  "keywords": [
    "toolsy",
    "sdk",
    "client",
    "api"
  ],
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "main": "./dist/node-js/index.js",
  "module": "./dist/node-js/index.mjs",
  "types": "./dist/node-js/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/node-js/index.d.mts",
        "default": "./dist/node-js/index.mjs"
      },
      "require": {
        "types": "./dist/node-js/index.d.ts",
        "default": "./dist/node-js/index.js"
      }
    },
    "./nest-js": {
      "import": {
        "types": "./dist/nest-js/index.d.mts",
        "default": "./dist/nest-js/index.mjs"
      },
      "require": {
        "types": "./dist/nest-js/index.d.ts",
        "default": "./dist/nest-js/index.js"
      }
    },
    "./types": {
      "import": {
        "types": "./dist/types/index.d.mts",
        "default": "./dist/types/index.mjs"
      },
      "require": {
        "types": "./dist/types/index.d.ts",
        "default": "./dist/types/index.js"
      }
    },
    "./entities": {
      "import": {
        "types": "./dist/entities/index.d.mts",
        "default": "./dist/entities/index.mjs"
      },
      "require": {
        "types": "./dist/entities/index.d.ts",
        "default": "./dist/entities/index.js"
      }
    },
    "./package.json": "./package.json"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "start": "yarn build && yarn --cwd ./example start",
    "build": "tsup",
    "deploy": "npm publish",
    "lint": "eslint --fix",
    "format": "prettier --write . --ignore-path .gitignore",
    "test": "yarn lint",
    "prepare": "husky"
  },
  "dependencies": {
    "@iamnnort/config": "^2.0.4",
    "@iamnnort/request": "^3.2.1",
    "big.js": "^7.0.1",
    "date-fns": "^4.4.0",
    "date-fns-tz": "^3.2.0",
    "lodash": "^4.18.1",
    "zod": "^4.4.3"
  },
  "peerDependencies": {
    "@nestjs/common": "^11.1.28"
  },
  "peerDependenciesMeta": {
    "@nestjs/common": {
      "optional": true
    }
  },
  "devDependencies": {
    "@nestjs/common": "^11.1.28",
    "@swc/core": "^1.15.47",
    "@types/big.js": "^7.0.0",
    "@types/node": "^25.2.3",
    "eslint": "^9.24.0",
    "husky": "^9.1.7",
    "lint-staged": "^15.5.1",
    "prettier": "^3.8.1",
    "tsup": "^8.4.0",
    "typescript": "^5.9.3"
  }
}
